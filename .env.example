# Sao chép thành .env rồi sửa giá trị:  cp .env.example .env
# File .env KHÔNG được commit lên Git (đã có trong .gitignore).

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Tạo chuỗi ngẫu nhiên:  openssl rand -hex 32
JWT_SECRET=

CORS_ORIGIN=

# Chỉ dùng cho docker-compose.prod.yml
IMAGE_OWNER=
TAG=
